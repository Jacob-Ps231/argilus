{
	"schemaVersion": 1,
	"id": "argilus",
	"version": "${version}",
	"name": "Argilus",
	"description": "A clay golem that tends a farm on its own. It harvests and replants crops, berries and nether wart, picks up what falls, and empties itself into a chest it remembers.",
	"authors": [
		"Jerome"
	],
	"license": "MIT",
	"icon": "assets/argilus/icon.png",
	"contact": {
		"homepage": "https://github.com/Jacob-Ps231/argilus",
		"sources": "https://github.com/Jacob-Ps231/argilus",
		"issues": "https://github.com/Jacob-Ps231/argilus/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"re.jerome.argilus.Argilus"
		],
		"client": [
			"re.jerome.argilus.client.ArgilusClient"
		]
	},
	"mixins": [
		"argilus.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
